# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Application Mode
MOCK_MODE=true
DEBUG=true
LOG_LEVEL=INFO

# Portal
PORTAL_URL=https://partner.nationalbroadband.pk/

# Audio
MICROPHONE_ENABLED=true
TTS_ENABLED=true

# UI
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900

# Database
DATABASE_PATH=data/cybernet.db

# Browser
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=0
